# PharmaGuard Environment Variables

# LLM Provider: "groq" (primary, free) or "gemini" (fallback, free)
LLM_PROVIDER=groq

# Groq API Key (free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Gemini API Key (free at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Demo Mode: set to "true" to bypass all LLM calls (instant responses, zero cost)
DEMO_MODE=false
