# AI Provider Keys (Required - Choose at least one)
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=...

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
LLM_PROVIDER=groq # or gemini

# Privacy & Security
# Salt for pseudonymizing patient IDs (Layer 3)
NEXT_PUBLIC_DISPLAY_SALT=PHARMAGUARD_SALT_CHANGE_ME

# Feature Flags
DEMO_MODE=false # Set to true to bypass LLM and use static fallback
