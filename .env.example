# Copy this file to frontend/.env.local and fill in real values.
# NEVER commit .env.local to source control.

FEATURE_USE_LLM=true
FEATURE_USE_LIVE_CPIC=true
FEATURE_SHOW_DEV_TOOLS=false

LLM_PROVIDER=groq

GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY="your_gemini_api_key_here"
SARVAM_API_KEY="your_sarvam_api_key_here"

CPIC_API_BASE=https://api.cpicpgx.org/v1

# Restrict CORS to your production domain
ALLOWED_ORIGIN=https://your-production-domain.com

META_WA_TOKEN=your_meta_access_token_here
META_WA_PHONE_ID=your_phone_number_id_here
META_WA_VERIFY_TOKEN=your_strong_random_verify_token_here
META_WA_APP_SECRET=your_meta_app_secret_here
